{
	"name": "cloudflare-scrapyard",
	"private": true,
	"version": "0.0.0",
	"type": "module",
	"scripts": {
		"dev": "npm run build:wasm && vite dev",
		"build": "npm run build:wasm && vite build",
		"build:wasm": "GOOS=wasip1 GOARCH=wasm go build -buildmode=c-shared -trimpath -ldflags=\"-s -w\" -o scrap-wasm.wasm github.com/Victorystick/scrapscript/cmd/scrap-wasm",
		"preview": "npm run build && vite preview",
		"deploy": "npm run build && wrangler deploy",
		"test": "npm run build:wasm && vitest run"
	},
	"devDependencies": {
		"@cloudflare/vite-plugin": "^1.65.0",
		"@cloudflare/workers-types": "^5.20261023.1",
		"@types/node": "^22.15.18",
		"miniflare": "^4.20260730.0",
		"vite": "^6.3.5",
		"vitest": "3.2.4",
		"wrangler": "^4.152.0"
	}
}
